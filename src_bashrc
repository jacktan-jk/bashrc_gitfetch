    ping_flag="-c 1 -W 0.1"
fi

if ! ping $ping_flag 1.1.1.1 &> /dev/null; then
    echo -e "${BLUE}[INTERNET]${NC} ${RED}Unavailable${NC}"
    echo -e "${PUR}[PYTHON]${NC}   ${U_WHITE}$py_type${NC}"
    cleanup
    if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
        return
    else
        exit 0
    fi
