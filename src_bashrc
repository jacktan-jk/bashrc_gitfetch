cleanup() {
    if ! $running; then
        return
    fi
    
    running=false
    echo -e "\nCancelling fetch..."
    if [ ${#pids[@]} -gt 0 ]; then
        for job in "${pids[@]}"; do
            if kill -0 "$job" 2>/dev/null; then
                kill "$job" 2>/dev/null
            fi
        done
        wait "${pids[@]}" 2>/dev/null
        pids=()
    fi
    [ -d "$tmp_dir" ] && rm -rf "$tmp_dir" 2>/dev/null
    cd "$home_dir"
}

git() {
  if [ "$1" = log ]; then
    shift
    command git log --graph "$@"
  else
    command git "$@"
  fi
}

git_repo_report() {
    [ "$running" != true ] && return

    local current_branch diffstat formatted_diff
    local full_ref short_ref upstream track symref remote branch rb
    local ahead behind stash_count files insertions deletions
    local i has_commits has_unstaged

    local -a updates=()
    local -a unstaged=()
    local -a new_branches=()
    local -a no_upstream=()
    local -a remote_candidates=()

    local -A local_map=()
    local -A origin_map=()
    local -A remote_seen=()

    current_branch=$(command git symbolic-ref --quiet --short HEAD 2>/dev/null || true)
    stash_count=$(command git rev-list --walk-reflogs --ignore-missing --count refs/stash 2>/dev/null || printf '0')

    # Read every local and remote branch in one git process. This avoids spawning
    # 3-4 git.exe processes for every local branch, which is expensive in Git Bash.
    while IFS=$'\x1f' read -r full_ref short_ref upstream track symref; do
        case "$full_ref" in
            refs/heads/*)
                branch=${full_ref#refs/heads/}
                local_map["$branch"]=1

                if [ -z "$upstream" ]; then
                    no_upstream+=("$branch")
                    continue
                fi

                if [ "$track" = "[gone]" ]; then
                    updates+=("'$branch' [ ${YEL}upstream gone${NC} ]")
                    continue
                fi

                ahead=0
                behind=0
                if [[ "$track" =~ ahead[[:space:]]+([0-9]+) ]]; then
                    ahead=${BASH_REMATCH[1]}
                fi
                if [[ "$track" =~ behind[[:space:]]+([0-9]+) ]]; then
                    behind=${BASH_REMATCH[1]}
                fi

                if (( behind > 0 && ahead > 0 )); then
                    updates+=("'$branch' [ ${RED}▼$behind${NC} ${GREEN}▲$ahead${NC} ]")
                elif (( behind > 0 )); then
                    updates+=("'$branch' [ ${RED}▼$behind${NC} ]")
                elif (( ahead > 0 )); then
                    updates+=("'$branch' [ ${GREEN}▲$ahead${NC} ]")
                fi
                ;;

            refs/remotes/*)
                # Skip symbolic refs such as origin/HEAD.
                [ -n "$symref" ] && continue

                remote=${short_ref%%/*}
                branch=${short_ref#*/}
                [ "$remote" = "$short_ref" ] && continue

                remote_candidates+=("$branch")
                if [ "$remote" = "origin" ]; then
                    origin_map["$branch"]=1
                fi
                ;;
        esac
    done < <(
        command git for-each-ref \
            --format='%(refname)%1f%(refname:short)%1f%(upstream:short)%1f%(upstream:track)%1f%(symref)' \
            refs/heads refs/remotes 2>/dev/null
    )

    # Match the previous behaviour: report a missing upstream only when an
    # origin branch with the same name exists.
    for branch in "${no_upstream[@]}"; do
        if [[ -n ${origin_map[$branch]+x} ]]; then
            updates+=("'$branch' [ ${YEL}no upstream configured${NC} ]")
        fi
    done

    # Remote branch names that do not have a matching local branch.
    for rb in "${remote_candidates[@]}"; do
        [[ -n ${local_map[$rb]+x} ]] && continue
        [[ -n ${remote_seen[$rb]+x} ]] && continue
        remote_seen["$rb"]=1
        new_branches+=("$rb")
    done

    # Check the worktree once per repository instead of once inside every
    # branch worker. This preserves the original tracked-file behaviour.
    if [ -n "$current_branch" ]; then
        diffstat=$(command git diff HEAD --shortstat 2>/dev/null || true)
        if [ -n "$diffstat" ]; then
            files=0
            insertions=0
            deletions=0

            if [[ "$diffstat" =~ ([0-9]+)[[:space:]]file(s)?[[:space:]]changed ]]; then
                files=${BASH_REMATCH[1]}
            fi
            if [[ "$diffstat" =~ ([0-9]+)[[:space:]]insertion(s)?\(\+\) ]]; then
                insertions=${BASH_REMATCH[1]}
            fi
            if [[ "$diffstat" =~ ([0-9]+)[[:space:]]deletion(s)?\(-\) ]]; then
                deletions=${BASH_REMATCH[1]}
            fi

            formatted_diff="$files file"
            (( files != 1 )) && formatted_diff+="s"
            (( insertions > 0 )) && formatted_diff+=" ${GREEN}+$insertions${NC}"
            (( deletions > 0 )) && formatted_diff+=" ${RED}-$deletions${NC}"
            unstaged+=("'$current_branch' → $formatted_diff")
        fi
    fi

    has_commits=false
    has_unstaged=false
    ((${#updates[@]} > 0)) && has_commits=true
    ((${#unstaged[@]} > 0)) && has_unstaged=true

    if ((${#new_branches[@]} > 0)); then
        echo -e "│"
        if $has_commits || $has_unstaged; then
            echo -e "├── ${BLUE}[ BRANCHES ]${NC}"
        else
            echo -e "└── ${BLUE}[ BRANCHES ]${NC}"
        fi

        for i in "${!new_branches[@]}"; do
            if [ "$i" -eq "$(( ${#new_branches[@]} - 1 ))" ]; then
                if $has_commits || $has_unstaged; then
                    echo -e "│\t└── \"${new_branches[$i]}\""
                else
                    echo -e "\t└── \"${new_branches[$i]}\""
                fi
            else
                if $has_commits || $has_unstaged; then
                    echo -e "│\t├── \"${new_branches[$i]}\""
                else
                    echo -e "\t├── \"${new_branches[$i]}\""
                fi
            fi
        done
        ! $has_commits && ! $has_unstaged && echo ""
    fi

    if $has_commits; then
        echo -e "│"
        if $has_unstaged; then
            echo -e "├── ${PUR}[ COMMITS ]${NC}"
        else
            echo -e "└── ${PUR}[ COMMITS ]${NC}"
        fi

        for i in "${!updates[@]}"; do
            if [ "$i" -eq "$(( ${#updates[@]} - 1 ))" ]; then
                if $has_unstaged; then
                    echo -e "│\t└── ${updates[$i]}"
                else
                    echo -e "\t└── ${updates[$i]}"
                fi
            else
                if $has_unstaged; then
                    echo -e "│\t├── ${updates[$i]}"
                else
                    echo -e "\t├── ${updates[$i]}"
                fi
            fi
        done
        ! $has_unstaged && echo ""
    fi

    if $has_unstaged; then
        echo -e "│"
        echo -e "└── ${RED}[ UNSTAGED ]${NC}"
        for i in "${!unstaged[@]}"; do
            if [ "$i" -eq "$(( ${#unstaged[@]} - 1 ))" ]; then
                echo -e "\t└── ${unstaged[$i]}"
            else
                echo -e "\t├── ${unstaged[$i]}"
            fi
        done
        echo ""
    fi

    if (( stash_count > 0 )); then
        echo -e "* ${stash_count} stash found.\n"
    fi
}

