############################################################################################################
# Start of console printouts and main feaatures
############################################################################################################

echo -e "${YEL}[TIP]${NC} To change python type, \"echo (0: WIN, 1: MINGW) > .disable_win_py\", restart"
echo -e "${YEL}[TIP]${NC} To disable fetch, \"echo 1 > .disable_fetch\""
echo -e "${YEL}[TIP]${NC} To cancel fetch, \"ctrl-C\"\n"

echo -e "${BLUE}[INTERNET]${NC} ${GREEN}OK${NC}"
echo -e "${PUR}[PYTHON]${NC}   ${U_WHITE}$py_type${NC}\n"

trap cleanup SIGINT SIGTERM

cols=$(tput cols 2>/dev/null || printf '80')
total_repo=0
pass_repo=0
# This file is sourced repeatedly, so reset the array instead of only
# redeclaring it. Otherwise old entries remain and PROFILE rows duplicate.
declare -a repo_list=()
tmp_dir=$(mktemp -d) || {
    echo -e "${RED}[ERROR] Unable to create temporary directory.${NC}"
    return 1 2>/dev/null || exit 1
}

pids=()
start_time_us=${EPOCHREALTIME/./}

# Keep a failed GitHub SSH handshake from holding up the complete parallel run.
# Override when needed, for example: GIT_SSH_CONNECT_TIMEOUT=10 source ~/.bashrc
ssh_connect_timeout="${GIT_SSH_CONNECT_TIMEOUT:-1}"
fetch_ssh_command="${GIT_SSH_COMMAND:-ssh} -o BatchMode=yes -o ConnectTimeout=${ssh_connect_timeout} -o ConnectionAttempts=1 -o ServerAliveInterval=5 -o ServerAliveCountMax=1"

for dir in "$tar_dir"/*; do
    [ "$running" != true ] && [ "${BASH_SOURCE[0]}" != "$0" ] && return
    [ ! -d "$dir/.git" ] && continue

    repo_name=${dir##*/}
    echo "Fetching: $repo_name..."
    ((total_repo++))
    repo_list+=("$repo_name")

    (
        repo_start=$SECONDS
        cd "$dir" || exit 1

        fetch_start=$SECONDS
        fetch_error_file="$tmp_dir/$repo_name.fetch.err"

        # --quiet suppresses normal progress, but Git still writes fatal SSH
        # diagnostics to stderr. Capture those diagnostics so startup remains
        # clean; set FETCH_DEBUG=1 to include them in the repository report.
        if ! GIT_SSH_COMMAND="$fetch_ssh_command" \
            command git fetch --quiet --all --prune \
                > /dev/null 2> "$fetch_error_file"; then
            fetch_elapsed=$((SECONDS - fetch_start))
            failure_reason="fetch failed"

            if grep -Eqi 'kex_exchange_identification|banner exchange|software caused connection abort' "$fetch_error_file"; then
                failure_reason="SSH connection aborted"
            elif grep -Eqi 'permission denied|publickey' "$fetch_error_file"; then
                failure_reason="SSH authentication failed"
            elif grep -Eqi 'could not resolve host|name or service not known' "$fetch_error_file"; then
                failure_reason="DNS lookup failed"
            elif grep -Eqi 'connection timed out|connection refused|connection reset' "$fetch_error_file"; then
                failure_reason="SSH connection failed"
            elif grep -Eqi 'could not read from remote repository|repository not found' "$fetch_error_file"; then
                failure_reason="remote unavailable or access denied"
            fi

            if [ -d "$tmp_dir" ]; then
                printf '%b\n' "${RED}[ERROR]${NC} $failure_reason.\n" \
                    > "$tmp_dir/$repo_name.log"

                if [ "${FETCH_DEBUG:-0}" = "1" ] && [ -s "$fetch_error_file" ]; then
                    printf '\n' >> "$tmp_dir/$repo_name.log"
                    cat "$fetch_error_file" >> "$tmp_dir/$repo_name.log"
                    printf '\n' >> "$tmp_dir/$repo_name.log"
                fi

                if [ "${FETCH_PROFILE:-0}" = "1" ]; then
                    printf '%s\t%s\t%s\t%s\t%s\n' \
                        "$repo_name" "$fetch_elapsed" "-" "$((SECONDS - repo_start))" "FAILED" \
                        > "$tmp_dir/$repo_name.time"
                fi
            fi

            rm -f "$fetch_error_file" 2>/dev/null
            exit 1
        fi
        fetch_elapsed=$((SECONDS - fetch_start))
        rm -f "$fetch_error_file" 2>/dev/null

        report_start=$SECONDS
        git_repo_report > "$tmp_dir/$repo_name.log" 2>&1
        report_elapsed=$((SECONDS - report_start))

        if [ "${FETCH_PROFILE:-0}" = "1" ]; then
            printf '%s\t%s\t%s\t%s\t%s\n' \
                "$repo_name" "$fetch_elapsed" "$report_elapsed" "$((SECONDS - repo_start))" "OK" \
                > "$tmp_dir/$repo_name.time"
        fi
    ) &
    pids+=("$!")
done

if [ "$total_repo" -eq 0 ]; then
    echo -e "${BLUE}* no previous fetch status.${NC}" > "$tar_dir/.status"
    rm -rf "$tmp_dir" 2>/dev/null
    if [ "${BASH_SOURCE[0]}" != "$0" ]; then
        return
    else
        exit
    fi
fi

# Fetch repositories in parallel, then collect each result.
for pid in "${pids[@]}"; do
    if wait "$pid"; then
        ((pass_repo++))
    fi
done

end_time_us=${EPOCHREALTIME/./}
elapsed_tenths=$(((end_time_us - start_time_us + 50000) / 100000))

printf -v elapsed_sec '%d.%d' \
    "$((elapsed_tenths / 10))" \
    "$((elapsed_tenths % 10))"
echo ""
if [ "$running" = true ]; then
    : > "$tar_dir/.status"

    printf -v separator '%*s' "$cols" ''
    separator=${separator// /─}

    for repo in "${repo_list[@]}"; do
        if [ -s "$tmp_dir/$repo.log" ]; then
            echo -e "${YEL}[ $repo ]${NC}" >> "$tar_dir/.status"
            cat "$tmp_dir/$repo.log" >> "$tar_dir/.status"
            printf '%s\n\n' "$separator" >> "$tar_dir/.status"
        fi
    done

    cat "$tar_dir/.status"

    if [ "${FETCH_PROFILE:-0}" = "1" ]; then
        repo_width=4

        for repo in "${repo_list[@]}"; do
            if [ -s "$tmp_dir/$repo.time" ]; then
                IFS=$'\t' read -r name _ _ _ _ < "$tmp_dir/$repo.time"
                [ "${#name}" -gt "$repo_width" ] && repo_width=${#name}
            fi
        done

        echo -e "${BCYAN}[PROFILE]${NC}"
        printf "  %-${repo_width}s | %7s | %7s | %7s | %s\n" \
            "REPOSITORY" "FETCH" "REPORT" "TOTAL" "RESULT"

        printf "  %-${repo_width}s-+-%7s-+-%7s-+-%7s-+-%s\n" \
            "$(printf '%*s' "$repo_width" '' | tr ' ' '-')" \
            "-------" "-------" "-------" "------"

        for repo in "${repo_list[@]}"; do
            if [ -s "$tmp_dir/$repo.time" ]; then
                IFS=$'\t' read -r name fetch_time report_time total_time result \
                    < "$tmp_dir/$repo.time"

                [ "$report_time" != "-" ] && report_time="${report_time}s"

                printf "  %-${repo_width}s | %6ss | %7s | %6ss | %s\n" \
                    "$name" \
                    "$fetch_time" \
                    "$report_time" \
                    "$total_time" \
                    "$result"
            fi
        done

        echo
    fi

    if [ "$total_repo" -eq "$pass_repo" ]; then
        echo -e "${GREEN}[SUCCESS]${NC} Fetched ${total_repo} repositories in ${elapsed_sec}s"
    else
        echo -e "${RED}[FAILED]${NC} Fetched ${pass_repo} of ${total_repo} repositories in ${elapsed_sec}s"
    fi
fi

[ -d "$tmp_dir" ] && rm -rf "$tmp_dir" 2>/dev/null
running=false
